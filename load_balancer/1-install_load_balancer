#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin
apt-get update -y
apt-get install -y haproxy

cat >> /etc/haproxy/haproxy.cfg << 'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7248-web-01 35.178.181.126:80 check
    server 7248-web-02 18.135.99.237:80 check
EOF

service haproxy restart

